# Python bytecode & cache
__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/

# Environment variables & secrets
.env
.env.local

# Node & Frontend build
node_modules/
dist/
.DS_Store

# Temporary & Scratch files
logs/
*.log
temp/
scratch/
scrapers/*/*.html
scrapers/*/*.txt
scrapers/**/*.html
scrapers/**/*.txt

# Database files & transient snapshots
data/*.db
data/*.db-shm
data/*.db-wal
data/snapshots/*
!data/snapshots/.gitkeep
*.sqlite
*.db

# Allow project package manifests and configs
!package.json
!**/package.json
!**/package-lock.json
