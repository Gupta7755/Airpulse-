# Airpulse environment configuration - copy to .env and fill in values

# MongoDB (local or Atlas). If unreachable, the backend falls back to an in-memory store.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=apix_mospi
USE_MONGODB=true

# Scraper scheduler
SCHEDULER_INTERVAL_MINUTES=30

# HTTP Basic Authentication for the API
API_AUTH_ENABLED=false
API_AUTH_USER=admin
API_AUTH_PASS=change-me

# Optional: extra comma-separated CORS origins
CORS_ORIGINS=

# Optional: OpenSky Network OAuth2 client (live ADS-B radar); anonymous access if blank
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Backup clients (_2, _3, ... up to _9) take over automatically when the previous one is rate-limited
OPENSKY_CLIENT_ID_2=
OPENSKY_CLIENT_SECRET_2=

# Optional: alert email delivery (EmailJS or SMTP)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend: backend base URL (leave blank in dev to use the Vite proxy)
VITE_API_BASE_URL=
